{
  "id": "/",
  "name": "Leaflet",
  "short_name": "Leaflet",
  "description": "A private reader for your EPUBs. Read together, remember more.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f4efe3",
  "theme_color": "#f4efe3",
  "categories": ["books", "education", "productivity"],
  "lang": "en",
  "icons": [
    { "src": "/icons/icon-128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "/icons/icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "/icons/icon-310.png", "sizes": "310x310", "type": "image/png" },
    {
      "src": "/icons/icon-310.png",
      "sizes": "310x310",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Open your shelf",
      "url": "/",
      "icons": [{ "src": "/icons/icon-128.png", "sizes": "128x128" }]
    },
    {
      "name": "Join a reading room",
      "short_name": "Join room",
      "description": "Read along with a code",
      "url": "/join",
      "icons": [{ "src": "/icons/icon-128.png", "sizes": "128x128" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "book",
          "accept": ["application/epub+zip", ".epub"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": { "application/epub+zip": [".epub"] }
    }
  ]
}
